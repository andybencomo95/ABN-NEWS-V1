FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY abn-api/go.mod abn-api/go.sum ./
RUN go mod download
COPY abn-api/ .
RUN CGO_ENABLED=0 GOOS=linux go build -o /poller ./cmd/poller/

FROM alpine:3.20
RUN apk --no-cache add ca-certificates
COPY --from=builder /poller /poller
COPY abn-api/migrations /migrations
CMD ["/poller"]
